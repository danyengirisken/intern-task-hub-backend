<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Rol <-> Yetki ara tablosu (PTT S_ROLE_PERMISSION referansi, composite PK) -->
    <changeSet author="danyengirisken" id="S_ROLE_PERMISSION" failOnError="false">
        <createTable tableName="S_ROLE_PERMISSION">
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="permission_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="S_ROLE_PERMISSION"
                columnNames="role_id, permission_id"
                constraintName="PK_S_ROLE_PERMISSION"/>
        <addForeignKeyConstraint
                baseTableName="S_ROLE_PERMISSION"
                baseColumnNames="role_id"
                constraintName="FK_S_ROLE_PERM_ROLE"
                referencedTableName="S_ROLE"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="S_ROLE_PERMISSION"
                baseColumnNames="permission_id"
                constraintName="FK_S_ROLE_PERM_PERM"
                referencedTableName="S_PERMISSION"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
