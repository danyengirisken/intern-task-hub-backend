<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Yetki (permission) tablosu (PTT S_PERMISSION referansi).
         Menuler bir yetkiye baglanir; yetki S_ROLE_PERMISSION ile rollere verilir. -->

    <changeSet author="danyengirisken" id="SEQ_S_PERMISSION" failOnError="false">
        <createSequence sequenceName="SEQ_S_PERMISSION" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet author="danyengirisken" id="S_PERMISSION" failOnError="false">
        <createTable tableName="S_PERMISSION">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="PK_S_PERMISSION" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_S_PERMISSION_NAME"/>
            </column>
            <column name="title" type="VARCHAR(150)"/>
            <!-- Auditable kolonlari -->
            <column name="created_by" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
