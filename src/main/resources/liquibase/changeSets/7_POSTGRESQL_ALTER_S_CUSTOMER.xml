<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="mirackoc" id="SEQ_S_CUSTOMER" failOnError="false">
        <createSequence sequenceName="SEQ_S_CUSTOMER" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet author="mirackoc" id="S_CUSTOMER" failOnError="false">
        <createTable tableName="S_CUSTOMER">

            <column name="id" type="BIGINT"/>

            <column name="partner_id" type="BIGINT">
                <constraints
                        primaryKey="true"
                        primaryKeyName="PK_S_CUSTOMER"
                        nullable="false"/>
            </column>

            <column name="code" type="VARCHAR(12)">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="country_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="city_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="town_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(4000)"/>

            <column name="active" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>

            <!-- Auditable kolonlari -->
            <column name="created_by" type="BIGINT"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_date" type="TIMESTAMP"/>

        </createTable>
    </changeSet>

    <changeSet id="ALTER_TABLE_S_CUSTOMER_DESCRIPTION_TO_VARCHAR" author="mirackoc">
        <modifyDataType
                tableName="S_CUSTOMER"
                columnName="description"
                newDataType="VARCHAR(4000)"/>
    </changeSet>

</databaseChangeLog>