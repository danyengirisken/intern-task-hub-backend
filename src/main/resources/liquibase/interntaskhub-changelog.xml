         ============================================================ -->

    <!-- Sema: temel tablolar -->
    <include file="liquibase/changeSets/1_POSTGRESQL_CREATE_S_ROLE.xml"/>
    <include file="liquibase/changeSets/2_POSTGRESQL_CREATE_S_MENU.xml"/>
    <include file="liquibase/changeSets/3_POSTGRESQL_CREATE_S_USER.xml"/>
    <include file="liquibase/changeSets/4_POSTGRESQL_CREATE_S_PARTNER.xml"/>

    <!-- Baslangic verisi: roller + kullanicilar -->
    <include file="liquibase/changeSets/5_POSTGRESQL_INITDATA.sql"/>

    <!-- S_MENU'yu hiyerarsik yapiya genislet -->
    <include file="liquibase/changeSets/6_POSTGRESQL_ALTER_S_MENU.xml"/>


    <!-- Görev (task) modülü -->
    <include file="liquibase/changeSets/9_POSTGRESQL_CREATE_T_TASK.xml"/>
